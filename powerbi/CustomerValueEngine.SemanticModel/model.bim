          }
        ],
        "lineageTag": "3095b9ce-1b15-4fad-9d60-b23835e6faa9",
        "measures": [
          {
            "name": "Revenue",
            "expression": "SUM(fact_invoice[Revenue])",
            "formatString": "£#,0",
            "lineageTag": "82bb00cb-5324-4113-a016-1444e73e2023"
          },
          {
            "name": "Orders",
            "expression": "COUNTROWS(fact_invoice)",
            "formatString": "#,0",
            "lineageTag": "f9872bb2-3510-4b5f-a665-f41f0bc521c4"
          },
          {
            "name": "Active Customers",
            "expression": "DISTINCTCOUNT(fact_invoice[Customer ID])",
            "formatString": "#,0",
            "lineageTag": "8525f5ae-88bb-4e41-9f7a-3bda949817df"
          },
          {
            "name": "Avg Order Value",
            "expression": "DIVIDE([Revenue], [Orders])",
            "formatString": "£#,0",
            "lineageTag": "2047ad64-73ad-427d-8edd-c90b53d3fbe5"
          },
          {
            "name": "Returns",
            "expression": "SUM(fact_return[Return Value])",
            "formatString": "£#,0",
            "lineageTag": "cc4494e2-72c7-47cb-a960-4660a40bfe40"
          },
          {
            "name": "Return Rate",
            "expression": "DIVIDE([Returns], [Revenue])",
            "formatString": "0.0%",
            "lineageTag": "e79fd9ca-1a9b-47b5-b94f-bc2061cb7674"
          },
          {
            "name": "Customers",
            "expression": "COUNTROWS(dim_customer)",
            "formatString": "#,0",
            "lineageTag": "bdd974eb-a6ef-4957-b262-39fba688753f"
          },
          {
            "name": "Repeat Customer Rate",
            "expression": "DIVIDE(CALCULATE([Customers], dim_customer[Purchase Days] > 1), [Customers])",
            "formatString": "0.0%",
            "lineageTag": "4730beae-076d-43d3-85bd-5422a4b3d23c"
          },
          {
            "name": "Revenue Share of Total",
            "expression": "DIVIDE([Revenue], CALCULATE([Revenue], ALL(dim_customer), ALL(dim_segment)))",
            "formatString": "0.0%",
            "lineageTag": "f994e070-f99a-4f72-8a91-07feb7962dd7"
          },
          {
            "name": "Top 20% Revenue Share",
            "expression": [
              "VAR n = ROUNDUP([Customers] * 0.2, 0)",
              "VAR biggest = TOPN(n, dim_customer, dim_customer[Revenue 2 Years], DESC)",
              "RETURN DIVIDE(SUMX(biggest, dim_customer[Revenue 2 Years]), SUM(dim_customer[Revenue 2 Years]))"
            ],
            "formatString": "0.0%",
            "lineageTag": "3330081e-5313-4d1f-97bd-80bcd8ff75b8"
          },
          {
            "name": "Actual Revenue",
            "expression": "SUM(fact_month[Actual Revenue])",
            "formatString": "£#,0",
            "lineageTag": "af0a89e7-400c-49e6-b3ad-ec826da074eb"
          },
          {
            "name": "Model Forecast",
            "expression": "SUM(fact_month[Model Forecast])",
            "formatString": "£#,0",
            "lineageTag": "73e7ac0f-916d-4d95-add3-8c4f2f093fad"
          },
          {
            "name": "Planning Forecast",
            "expression": "SUM(fact_month[Planning Forecast])",
            "formatString": "£#,0",
            "lineageTag": "5c23fc9c-71e0-4294-9efd-422d269e55c4"
          },
          {
            "name": "Retention %",
            "expression": "DIVIDE(SUM(fact_cohort[Active Customers]), SUM(fact_cohort[Cohort Size]))",
            "formatString": "0.0%",
            "lineageTag": "662ac83a-04b8-4359-bf4c-1c0d930cd62a"
          },
          {
            "name": "New Customer Retention",
            "expression": [
              "IF(SELECTEDVALUE(fact_cohort[Months Since First Purchase]) = 0, BLANK(),",
              "    CALCULATE([Retention %], fact_cohort[Cohort Type] = \"New customers\"))"
            ],
            "formatString": "0%",
            "lineageTag": "43e11ddf-a5ab-49c6-9891-208bf459e7ef"
          },
          {
            "name": "Retention First Year",
            "expression": [
              "VAR age = SELECTEDVALUE(fact_cohort[Months Since First Purchase])",
              "RETURN IF(age >= 1 && age <= 12, CALCULATE([Retention %], fact_cohort[Cohort Type] = \"New customers\"))"
            ],
            "formatString": "0.0%",
            "lineageTag": "7677bc51-e6f1-4a17-b538-197472f90d52"
          },
          {
            "name": "Month 1 Retention",
            "expression": "CALCULATE([Retention %], fact_cohort[Cohort Type] = \"New customers\", fact_cohort[Months Since First Purchase] = 1)",
            "formatString": "0.0%",
            "lineageTag": "46cee255-018d-471a-9ba4-772c8c9f2a6b"
          },
          {
            "name": "Model Value 26w",
            "expression": "SUM(dim_customer[Model Value 26w])",
            "formatString": "£#,0",
            "lineageTag": "7fb774c1-1a2b-48da-99ea-e8cc12d015df"
          },
          {
            "name": "Planning Value 26w",
            "expression": "SUM(dim_customer[Planning Value 26w])",
            "formatString": "£#,0",
            "lineageTag": "30f9032f-ac79-476c-9f89-ab76b4002ba0"
          },
          {
            "name": "Value At Risk 26w",
            "expression": "SUM(dim_customer[Value At Risk 26w])",
            "formatString": "£#,0",
            "lineageTag": "cf1d11ef-2884-42e3-94c9-8a7b558a60d5"
          },
          {
            "name": "Avg P Alive",
            "expression": "AVERAGE(dim_customer[P Alive])",
            "formatString": "0.0%",
            "lineageTag": "0169022f-4962-4ab3-a1cf-5e329f16378f"
          },
          {
            "name": "Top 25 Planning Value",
            "expression": "IF(MIN(dim_customer[Value Rank]) <= 25, [Planning Value 26w])",
            "formatString": "£#,0",
            "lineageTag": "e5504ec4-d906-4086-9801-af8259828456"
          },
          {
            "name": "Planned Spend",
            "expression": "SUM(dim_customer[Recommended Spend])",
            "formatString": "£#,0",
            "lineageTag": "8e728629-6cf6-42ea-bc00-8f463448af1a"
          },
          {
            "name": "Accounts Targeted",
            "expression": "CALCULATE([Customers], dim_customer[In Target List] = \"Yes\")",
            "formatString": "#,0",
            "lineageTag": "456a1935-bf99-4523-9165-a2008c8c1eae"
          },
          {
            "name": "Expected Extra Revenue",
            "expression": "SUM(dim_customer[Expected Extra Revenue])",
            "formatString": "£#,0",
            "lineageTag": "77213cf7-7a84-4098-bfc8-48bb62f54c55"
          },
          {
            "name": "Margin Value",
            "expression": "SELECTEDVALUE('Margin'[Margin], 0.35)",
            "formatString": "0%",
            "lineageTag": "62cd9fbc-eef3-4c52-aa51-be639cf96542"
          },
          {
            "name": "Expected Extra Margin",
            "expression": "[Expected Extra Revenue] * [Margin Value]",
            "formatString": "£#,0",
            "lineageTag": "7db250cf-bca6-4978-ab7c-5c10db1fcf86"
          },
          {
            "name": "Margin Back per Pound",
            "expression": "DIVIDE([Expected Extra Margin], [Planned Spend])",
            "formatString": "£#,0.00",
            "lineageTag": "8ac7f2b2-8194-4a3f-a6cc-492b2aea9385"
          },
          {
            "name": "Profit After Spend",
            "expression": "[Expected Extra Margin] - [Planned Spend]",
            "formatString": "£#,0",
            "lineageTag": "fe0d0595-d53f-4c50-984a-d219e01b7951"
          },
          {
            "name": "Target Spend",
            "expression": "VAR s = SUM(dim_customer[Recommended Spend]) RETURN IF(s > 0, s)",
            "formatString": "£#,0",
            "lineageTag": "3a45a8c0-8138-48c2-a0c1-3be6aa9a7788"
          },
          {
            "name": "Target Extra Revenue",
            "expression": "IF(SUM(dim_customer[Recommended Spend]) > 0, SUM(dim_customer[Expected Extra Revenue]))",
            "formatString": "£#,0",
            "lineageTag": "205c2049-69b1-428f-abd6-faa9807f9a39"
          },
          {
            "name": "Budget Profit",
            "expression": "SUM(plan_budget_curve[Incremental Profit])",
            "formatString": "£#,0",
            "lineageTag": "7aeacf98-ac45-4490-9b82-654c07dca0c7"
          },
          {
            "name": "Strategy Median Profit",
            "expression": "SUM(plan_strategies[Median Profit])",
            "formatString": "£#,0",
            "lineageTag": "5c8b25a2-b8db-466c-b6d1-ff0677beea19"
          },
          {
            "name": "Strategy Base Case Profit",
            "expression": "SUM(plan_strategies[Base Case Profit])",
            "formatString": "£#,0",
            "lineageTag": "c8f9827f-3c7d-42b4-aba5-ff4ae78adb6b"
          },
          {
            "name": "Segment Spend Low",
            "expression": "SUM(dim_segment[Spend Low])",
            "formatString": "£#,0",
            "lineageTag": "145bd448-fc0b-45de-a495-6eb393fa829e"
          },
          {
            "name": "Segment Spend High",
            "expression": "SUM(dim_segment[Spend High])",
            "formatString": "£#,0",
            "lineageTag": "864a2afd-609e-4d4e-bae8-baa49a4a4e5e"
          }
        ],
