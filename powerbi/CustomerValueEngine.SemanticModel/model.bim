            "name": "P Alive Band Order",
            "dataType": "int64",
            "expression": "SWITCH(TRUE(), dim_customer[P Alive] >= 0.9, 1, dim_customer[P Alive] >= 0.7, 2, dim_customer[P Alive] >= 0.4, 3, 4)",
            "isHidden": true,
            "lineageTag": "08ea7c59-b20d-4a31-9504-4ceea3682334",
            "summarizeBy": "none",
            "type": "calculated"
