                "    Typed = Table.TransformColumnTypes(Promoted, {{\"Customer ID\", type text}, {\"Country\", type text}, {\"First Purchase\", type date}, {\"Last Purchase\", type date}, {\"Cohort Month\", type date}, {\"Customer Type\", type text}, {\"Purchase Days\", Int64.Type}, {\"Revenue 2 Years\", type number}, {\"Returns 2 Years\", type number}, {\"Days Since Last Purchase\", Int64.Type}, {\"R Score\", Int64.Type}, {\"F Score\", Int64.Type}, {\"M Score\", Int64.Type}, {\"RFM Code\", type text}, {\"Segment\", type text}, {\"P Alive\", type number}, {\"Expected Purchases 26w\", type number}, {\"Expected Order Value\", type number}, {\"Model Value 26w\", type number}, {\"Planning Value 26w\", type number}, {\"Value At Risk 26w\", type number}, {\"Value Rank\", Int64.Type}, {\"Value Decile\", Int64.Type}, {\"Recommended Spend\", type number}, {\"Expected Extra Revenue\", type number}, {\"Recommended Action\", type text}, {\"In Target List\", type text}}, \"en-US\")",
                "in",
                "    Typed"
              ],
              "type": "m"
            }
          }
        ]
