            "name": "P Alive Band",
            "dataType": "string",
            "expression": "SWITCH(TRUE(), dim_customer[P Alive] >= 0.9, \"90% and over\", dim_customer[P Alive] >= 0.7, \"70 to 90%\", dim_customer[P Alive] >= 0.4, \"40 to 70%\", \"under 40%\")",
